// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nome      String
  produtos  Produto[]
  combos    Combo[]
}

model Produto {
  id          Int      @id @default(autoincrement())
  nome        String
  valor       Float
  custo       Float
  qntEstoque  Int
  categoria   Categoria @relation(fields: [idCategoria], references: [id])
  idCategoria Int
  itemCombos  ItemCombo[]
  itemPedidos ItemPedido[]
}

model Combo {
  id           Int      @id @default(autoincrement())
  nome         String
  qtdItens     Int
  categoria    Categoria @relation(fields: [idCategoria], references: [id])
  idCategoria  Int
  valor        Float
  itensCombo   ItemCombo[]
  itemPedidos  ItemPedido[]
}

model ItemCombo {
  id        Int     @id @default(autoincrement())
  combo     Combo   @relation(fields: [idCombo], references: [id])
  idCombo   Int
  produto   Produto @relation(fields: [idProduto], references: [id])
  idProduto Int
  qtdItens  Int
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String
  pedidos   Pedido[]
}

model Pedido {
  id          Int      @id @default(autoincrement())
  cliente     Cliente  @relation(fields: [idCliente], references: [id])
  idCliente   Int
  dataPedido  DateTime @default(now())
  status      Boolean  @default(false)
  valorItens  Float
  taxa        Float
  valorTotal  Float
  itensPedido ItemPedido[]
}

model ItemPedido {
  id        Int     @id @default(autoincrement())
  pedido    Pedido  @relation(fields: [idPedido], references: [id])
  idPedido  Int
  produto   Produto? @relation(fields: [idProduto], references: [id])
  idProduto Int?
  combo     Combo?   @relation(fields: [idCombo], references: [id])
  idCombo   Int?
  precoUn   Float
}